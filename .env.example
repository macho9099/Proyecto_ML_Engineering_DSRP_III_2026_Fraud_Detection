# Copiar a .env y completar (nunca commitear el .env real).

# Ruta al CSV crudo de PaySim si no esta en data/raw/
RAW_DATA_PATH=data/raw/PS_20174392719_1491204439457_log.csv

# MLflow: por defecto local (sqlite:///mlflow.db). Para usar DagsHub como backend remoto,
# descomentar y completar con las credenciales del repo en DagsHub.
# MLFLOW_TRACKING_URI=https://dagshub.com/<usuario>/<repo>.mlflow
# MLFLOW_TRACKING_USERNAME=<usuario>
# MLFLOW_TRACKING_PASSWORD=<token>
# MLFLOW_EXPERIMENT_NAME=fraud-detection-paysim
