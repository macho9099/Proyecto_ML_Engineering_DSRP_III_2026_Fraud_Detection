# --- Datos crudos (pesados, no se versionan) ---
data/raw/*.csv
data/raw/*.zip
!data/raw/.gitkeep

# --- Datos procesados pesados (regenerables con notebooks/1.0-...) ---
# Sobre el dataset completo, reference.csv/production*.csv pesan cientos de
# MB -- no se versionan. Si un artefacto derivado es chico (p.ej. un resumen
# de metricas), se puede excluir aqui de este patron para si versionarlo.
data/processed/*.csv
!data/processed/.gitkeep
!data/processed/performance_drift_over_time.csv

# --- Entornos virtuales ---
.venv/
venv/
env/
__pycache__/
*.pyc

# --- MLflow local ---
mlruns/
mlartifacts/
mlflow.db

# --- Jupyter ---
.ipynb_checkpoints/

# --- Evidently / Reporte HTML del proyecto ---
# Se versiona el reporte final real (pedido por el enunciado); si se
# vuelve a correr el notebook de monitoreo con otra configuracion, estos
# archivos cambian y se commitean de nuevo deliberadamente.
!app/reports/.gitkeep

# --- Artefactos de modelo y figuras del entregable final ---
# El modelo campeon (fraud_model.pkl, ~224KB) y las figuras de
# interpretabilidad (SHAP/LIME/matriz de confusion, unas decenas de KB
# cada una) se versionan como evidencia del entregable final.
!artifacts/models/.gitkeep
!reports/.gitkeep

# --- Credenciales / entorno ---
.env
kaggle.json

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
